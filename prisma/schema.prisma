generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum DayOfWeek {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ResearchType {
  PENELITIAN
  PKM
}

enum ValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Vector store (RAG)
// ---------------------------------------------------------------------------

model PdfChunk {
  id           Int      @id @default(autoincrement())
  documentId   String   @map("document_id")
  documentName String   @map("document_name")
  documentHash String   @map("document_hash")
  pageNumber   Int?     @map("page_number")
  chunkIndex   Int      @map("chunk_index")
  chunkText    String   @map("chunk_text") @db.Text
  tokenCount   Int      @map("token_count")
  embedding    Unsupported("vector(1024)")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([documentHash, chunkIndex])
  @@index([documentId])
  @@map("vectors")
}

// NOTE: Prisma cannot declare an HNSW/IVFFlat index on `embedding` through
// the schema DSL. After migrating, add it manually via raw SQL, e.g.:
//
//   CREATE INDEX vectors_embedding_hnsw_idx
//     ON vectors USING hnsw (embedding vector_cosine_ops);
//
// Without this, similarity search does a full table scan.

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model StudyProgram {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  degreeLevel   String   @map("degree_level") // e.g., "S1", "D3"
  faculty       String?
  accreditation String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("study_programs")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  password      String?
  image         String?

  // Academic-specific fields
  nidn             String? @unique // Acronyms like NIDN/NIP remain as is
  nip              String? @unique
  academicRank     String? @map("academic_rank") // e.g., "Asisten Ahli", "Lektor"
  highestEducation String? @map("highest_education") // e.g., "S2", "S3"

  studyProgramId String?       @map("study_program_id")
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)

  // FIX: previously `role` was reused as both the relation name and the FK
  // scalar (`fields: [role]`), which is invalid — a relation needs its own
  // scalar FK column. Also added the missing back-relation on Role.
  roleName String? @map("role_name")
  role     Role?   @relation(fields: [roleName], references: [name], onDelete: SetNull)

  researches   Research[]
  sessions     Session[]
  accounts     Account[]
  schedules    Schedule[]
  chatSessions ChatSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studyProgramId])
  @@index([roleName])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Auth (better-auth style)
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verification")
}

// ---------------------------------------------------------------------------
// Portal / navigation
// ---------------------------------------------------------------------------

model PortalMenu {
  id             String   @id @default(uuid())
  title          String
  description    String
  icon           String
  href           String
  order          Int      @default(0)
  visibleToRoles String[] @map("visible_to_roles")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("portal_menu")
}

// ---------------------------------------------------------------------------
// Schedules
// ---------------------------------------------------------------------------

model Schedule {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FIX: was free-form String; enum enforces the 7 valid Indonesian day names
  day        DayOfWeek
  startTime  String    @map("start_time") // "HH:MM"
  endTime    String    @map("end_time") // "HH:MM"
  courseName String    @map("course_name")
  courseCode String?   @map("course_code")
  className  String    @map("class_name") // e.g. "IF-A"
  room       String
  sks        Int       @default(2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Prevents the exact same user/day/time-slot from being scheduled twice.
  // Does NOT catch partial time-range overlaps — validate those in the app layer.
  @@unique([userId, day, startTime, endTime])
  @@index([userId])
  @@map("schedules")
}

// ---------------------------------------------------------------------------
// Research / LPPM workflow
// ---------------------------------------------------------------------------

model Research {
  // FIX: was `@unique` with no `@id` — every model needs a primary key.
  id             String @id @default(uuid())
  trPengusulanId String @map("tr_pengusulan_id")
  tahap          String

  dokumenPengajuan String? @map("dokumen_pengajuan")

  // FIX: money fields as String prevent aggregation/sorting; Decimal keeps
  // exact precision (unlike Float) which matters for currency.
  biaya       Decimal @db.Decimal(14, 2)
  danaInternal Decimal? @map("dana_internal") @db.Decimal(14, 2)

  // FIX: 0/1/2 Int flags had no explicit meaning — enum documents intent
  // and prevents invalid values.
  validasiStafLppm ValidationStatus @default(PENDING) @map("validasi_staf_lppm")
  validasiLppm     ValidationStatus @default(PENDING) @map("validasi_lppm")
  validasiRektor   ValidationStatus @default(PENDING) @map("validasi_rektor")
  status           Int              @default(0) // overall workflow status code

  // FIX: was String; DateTime enables correct sorting/filtering by date.
  tanggal DateTime

  catatan String?
  slip    String?

  // FIX: was free-form String ("PENELITIAN" | "PKM" in a comment only).
  jenis ResearchType

  judul          String  @db.Text
  rencanaLuaran  String? @map("rencana_luaran") @db.Text
  namaDosen      String  @map("nama_dosen")
  jenisPencairan String  @map("jenis_pencairan")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([jenis])
  @@map("research")
}

// ---------------------------------------------------------------------------
// Chat / assistant
// ---------------------------------------------------------------------------

model ChatSession {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Chat baru")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]

  @@index([userId, updatedAt])
  @@map("chat_session")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // FIX: was free-form String ("user" | "assistant" in a comment only).
  role      ChatRole
  content   String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_message")
}

// ---------------------------------------------------------------------------
// Misc
// ---------------------------------------------------------------------------

model Dataset {
  id          String   @id @default(uuid())
  name        String
  description String?
  content     String   @db.Text
  source      String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("datasets")
}

model AiSetting {
  id                  String   @id @default("default")
  activeProvider      String   @default("gemini") @map("active_provider")
  geminiPrimary       String   @default("gemini-3.8-flash") @map("gemini_primary")
  geminiFallbacks     String[] @default(["gemini-2.0-flash", "gemini-1.5-flash", "gemini-2.0-flash-lite"]) @map("gemini_fallbacks")
  ollamaBaseUrl       String   @default("http://localhost:11434") @map("ollama_base_url")
  ollamaModel         String   @default("llama3.2") @map("ollama_model")
  enableAutoFallback  Boolean  @default(true) @map("enable_auto_fallback")
  enableCrossFallback Boolean  @default(true) @map("enable_cross_fallback")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}
